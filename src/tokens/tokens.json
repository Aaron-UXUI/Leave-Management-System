{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "source": "Figma",
    "fileKey": "uTkRlCM3V9ZlH6GFowHy33",
    "fileName": "【設計】請假系統＿本土語文直播共學",
    "componentPage": "1795:12587 (🔶 Component)",
    "syncedAt": "2026-07-28",
    "note": "本檔為 Figma Variables 的鏡像，是 tokens.css / tokens.ts 的唯一產生來源。請勿手改衍生檔；要改值請先改 Figma，再重新同步本檔並執行 npm run tokens:build。",
    "openQuestions": [
      "色階沒有缺口：Primary 與 Grey Scale 只定義到目前這些階，是設計上刻意的取捨（2026-07-28 由設計者確認）。新增色階前請先在 Figma 討論。注意 get_variable_defs 只會回傳「被元件實際引用」的變數，所以 Figma 中定義了但未使用的色階不會出現在同步結果裡（Grey Scale/600 就是這種情況，直到它被用在 Dropdown 與 Search Bar 才浮現）。",
      "間距有兩套命名並存：Spacing/s|m|l 與 Spacing/s(8)|sm(12)|m(16)。兩者對 m 的定義衝突 —— Spacing/m=12 但 Spacing/m(16)=16。Search Bar 已改綁主要那套，但 Bar 區塊（1804:13177）仍在用括號那組。建議在 Figma 全面改綁後刪除。",
      "Figma 中 Type Scale/body/L = 14 與 body/L = 20 衝突，建議在 Figma 移除舊的 Type Scale 群組。",
      "Figma 變數群組名 'coner radius' 為拼字錯誤（應為 corner），程式端已正規化為 radius。"
    ]
  },

  "color": {
    "$type": "color",
    "$description": "鏡像 Figma 的 Semantic 層。Figma 另有 Primitive 層在其下，元件不直接引用它，因此程式端也不暴露 —— 詳見 docs/figma-sync.md。",
    "primary": {
      "100": { "$value": "#e1e8f0", "$extensions": { "figma": "Semantic/Primary/100" } },
      "200": { "$value": "#c3d1e0", "$extensions": { "figma": "Semantic/Primary/200" } },
      "300": { "$value": "#a3bbd6", "$extensions": { "figma": "Semantic/Primary/300" } },
      "400": { "$value": "#93aecc", "$extensions": { "figma": "Semantic/Primary/400" } },
      "700": { "$value": "#4d7099", "$extensions": { "figma": "Semantic/Primary/700" } },
      "800": { "$value": "#355a85", "$extensions": { "figma": "Semantic/Primary/800" } },
      "900": { "$value": "#254973", "$extensions": { "figma": "Semantic/Primary/900" } }
    },
    "grey": {
      "0": { "$value": "#fafafa", "$extensions": { "figma": "Semantic/Grey Scale/0" } },
      "100": { "$value": "#dcdcdc", "$extensions": { "figma": "Semantic/Grey Scale/100" } },
      "200": { "$value": "#c3c3c3", "$extensions": { "figma": "Semantic/Grey Scale/200" } },
      "300": { "$value": "#aaaaaa", "$extensions": { "figma": "Semantic/Grey Scale/300" } },
      "400": {
        "$value": "#929292",
        "$extensions": {
          "figma": "Semantic/Grey Scale/400",
          "unverified": true,
          "note": "⚠ 追溯路徑未經驗證。此色階在改為兩層結構前叫 Grey Scale/400（值 #929292 已確認），'Semantic/' 前綴是依其他色階的規律推斷的。掃不到的原因已查明：程式端只在 TextField 與 Choice 的 disabled 文字用它，而那兩個狀態是 Figma 未定義、由程式端補上的（見 docs/figma-gaps.md B），所以 Figma 端本來就沒有元件引用它，get_variable_defs 自然掃不到。請設計端確認：(1) 這個色階在 Figma 中是否仍存在、完整名稱為何；(2) disabled 文字應該用哪一階。"
        }
      },
      "600": { "$value": "#737373", "$extensions": { "figma": "Semantic/Grey Scale/600" } },
      "700": { "$value": "#4e4e4e", "$extensions": { "figma": "Semantic/Grey Scale/700" } },
      "900": { "$value": "#262626", "$extensions": { "figma": "Semantic/Grey Scale/900" } }
    },
    "success": {
      "text": {
        "$value": "#365c00",
        "$extensions": { "figma": "Semantic/Semantic Color/Success-text" }
      },
      "icon": {
        "$value": "#5d960e",
        "$extensions": { "figma": "Semantic/Semantic Color/Success-icon" }
      }
    },
    "destruct": {
      "text": {
        "$value": "#ab0000",
        "$extensions": { "figma": "Semantic/Semantic Color/Destruct-text" }
      },
      "icon": {
        "$value": "#c74040",
        "$extensions": { "figma": "Semantic/Semantic Color/Destruct-icon" }
      }
    }
  },

  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px", "$extensions": { "figma": "Spacing/0" } },
    "xs": { "$value": "4px", "$extensions": { "figma": "Spacing/xs" } },
    "s": { "$value": "8px", "$extensions": { "figma": "Spacing/s" } },
    "m": { "$value": "12px", "$extensions": { "figma": "Spacing/m" } },
    "l": { "$value": "16px", "$extensions": { "figma": "Spacing/l" } },
    "xl": { "$value": "24px", "$extensions": { "figma": "Spacing/xl" } },
    "3xl": { "$value": "48px", "$extensions": { "figma": "Spacing/3xl" } },
    "4xl": { "$value": "64px", "$extensions": { "figma": "Spacing/4xl" } }
  },

  "radius": {
    "$type": "dimension",
    "0": { "$value": "0px", "$extensions": { "figma": "coner radius/0" } },
    "xs": { "$value": "4px", "$extensions": { "figma": "coner radius/xs" } },
    "s": { "$value": "8px", "$extensions": { "figma": "coner radius/s" } },
    "l": { "$value": "16px", "$extensions": { "figma": "coner radius/l" } },
    "rounded": {
      "$value": "9999px",
      "$extensions": {
        "figma": "coner radius/rounded",
        "figmaRawValue": 100000,
        "note": "Figma 用 100000 表示完全圓角；CSS 端以 9999px 等效表示。"
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "\"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
        "$extensions": { "figma": "Typeface/Noto Sans TC（PingFang TC 為 Figma 中的次要字體）" }
      },
      "mono": {
        "$value": "\"SF Mono\", ui-monospace, Menlo, Consolas, monospace",
        "$extensions": { "figma": "Typeface/SF Mono" }
      }
    },
    "size": {
      "$type": "dimension",
      "h1": { "$value": "32px", "$extensions": { "figma": "Font Size/H1" } },
      "h2": { "$value": "24px", "$extensions": { "figma": "Font Size/H2" } },
      "h3": { "$value": "20px", "$extensions": { "figma": "Font Size/H3" } },
      "h4": { "$value": "16px", "$extensions": { "figma": "Font Size/H4" } },
      "label": { "$value": "20px", "$extensions": { "figma": "Font Size/Label" } },
      "body": { "$value": "16px", "$extensions": { "figma": "Font Size/body" } }
    },
    "lineHeight": {
      "$type": "dimension",
      "h1": { "$value": "40px", "$extensions": { "figma": "Line height/H1" } },
      "h2": { "$value": "36px", "$extensions": { "figma": "Line height/H2" } },
      "h3": { "$value": "30px", "$extensions": { "figma": "Line height/H3" } },
      "h4": { "$value": "24px", "$extensions": { "figma": "Line height/H4" } },
      "label": { "$value": "30px", "$extensions": { "figma": "Line height/Label" } },
      "body": { "$value": "24px", "$extensions": { "figma": "Line height/body" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400", "$extensions": { "figma": "Weight/Regular" } },
      "medium": { "$value": "500", "$extensions": { "figma": "Weight/Medium" } },
      "bold": { "$value": "700", "$extensions": { "figma": "Weight/Bold" } }
    }
  },

  "typography": {
    "$type": "typography",
    "headline-1": {
      "$value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": "700", "letterSpacing": "0" },
      "$extensions": { "figma": "Headline/1" }
    },
    "headline-2": {
      "$value": { "fontSize": "24px", "lineHeight": "36px", "fontWeight": "500", "letterSpacing": "0" },
      "$extensions": { "figma": "Headline/2" }
    },
    "headline-3": {
      "$value": { "fontSize": "20px", "lineHeight": "30px", "fontWeight": "500", "letterSpacing": "0" },
      "$extensions": { "figma": "Headline/3" }
    },
    "headline-4": {
      "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": "500", "letterSpacing": "0" },
      "$extensions": { "figma": "Headline/4" }
    },
    "body-l": {
      "$value": { "fontSize": "20px", "lineHeight": "30px", "fontWeight": "400", "letterSpacing": "0" },
      "$extensions": { "figma": "body/L" }
    },
    "body-m": {
      "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": "400", "letterSpacing": "0" },
      "$extensions": { "figma": "body/M" }
    }
  },

  "elevation": {
    "$type": "shadow",
    "low": {
      "$value": "0 1px 4px 0 #dcdcdc",
      "$extensions": { "figma": "Elevation/Low", "figmaSpec": "DROP_SHADOW color=Semantic/Grey Scale/100 offset=(0,1) radius=4 spread=0" }
    },
    "medium": {
      "$value": "2px 2px 4px 0 #c3c3c3, 0 4px 16px 0 #c3c3c3",
      "$extensions": { "figma": "Elevation/Medium", "figmaSpec": "DROP_SHADOW color=Semantic/Grey Scale/200 offset=(2,2) radius=4；DROP_SHADOW color=Semantic/Grey Scale/200 offset=(0,4) radius=16" }
    },
    "high": {
      "$value": "0 3px 24px 0 #c3c3c3, 0 3px 6px 0 #dcdcdc",
      "$extensions": { "figma": "Elevation/High", "figmaSpec": "DROP_SHADOW color=Semantic/Grey Scale/200 offset=(0,3) radius=24；DROP_SHADOW color=Semantic/Grey Scale/100 offset=(0,3) radius=6" }
    }
  }
}
