{
  "name": "@aaron-uxui/leave-management-design-system",
  "version": "0.1.0",
  "private": false,
  "description": "請假系統＿本土語文直播共學 設計系統。唯一真實來源為 Figma。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-UXUI/Leave-Management-System.git"
  },
  "homepage": "https://aaron-uxui.github.io/Leave-Management-System/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/tokens/tokens.json"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/leave-ds.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens.json": "./src/tokens/tokens.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "vrt": "playwright test tests/visual.spec.ts",
    "vrt:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "a11y": "playwright test tests/a11y.spec.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run tokens:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10"
  }
}
